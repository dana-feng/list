{
  "expo": {
    "name": "echi",
    "slug": "list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danafeng.list"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F3E5",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#3A1000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "echi uses your photos to add pictures to your lists and profile.",
          "cameraPermission": "echi uses your camera to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "echi uses your contacts to find friends who are already here."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "list",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0760a3a1-2874-4aa6-8198-4274e37186f2"
      }
    },
    "owner": "dfeng21"
  }
}
