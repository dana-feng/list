{
  "expo": {
    "name": "list",
    "slug": "list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danafeng.list"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "list uses your photos to add pictures to your lists and profile.",
          "cameraPermission": "list uses your camera to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "list checks the phone numbers in your contacts against list's members to find friends who are already here. your contacts aren't stored."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "list",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0760a3a1-2874-4aa6-8198-4274e37186f2"
      }
    },
    "owner": "dfeng21"
  }
}
