{
  "expo": {
    "name": "list",
    "slug": "list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danafeng.list"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-contacts",
        {
          "contactsPermission": "list checks your contacts for friends who are already here. Numbers never leave your phone except to find matches."
        }
      ]
    ],
    "scheme": "list",
    "experiments": {
      "typedRoutes": false
    }
  }
}
