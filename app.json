{
  "expo": {
    "name": "list",
    "slug": "list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danafeng.list"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "list uses your photos to add pictures to your lists and profile.",
          "cameraPermission": "list uses your camera to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "list uses your contacts to find friends who are already here."
        }
      ]
    ],
    "scheme": "list",
    "experiments": {
      "typedRoutes": false
    }
  }
}
